# Kartoteka DK — production environment.
# Copy to .env next to docker-compose.prod.yml and fill in. Never commit .env.

# Database. The password is only ever used inside the compose network.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER=kartoteka
POSTGRES_PASSWORD=
POSTGRES_DB=kartoteka

# The domain Caddy will obtain a certificate for. Must already point at this
# server, or the certificate request fails.
# It has to name the SAME host as APP_URL below: a mismatch means the
# certificate is issued for one domain while every passkey is scoped to
# another, and nobody can sign in over the address that actually answers.
APP_DOMAIN=kartoteka.example.pl

# Used to build invitation links AND to derive the passkey relying-party id and
# origin (src/lib/auth/webauthn/config.ts) — it must match the address people open.
# Required in production: missing or malformed, and the application refuses to
# start (src/instrumentation.ts), naming the variable in the container log.
# Give it the full address including https:// — a bare host is not an address.
# Settle DNS and this value BEFORE anyone registers a key: a passkey is bound to
# whatever domain APP_URL names at the moment of registration, and changing the
# domain afterwards invalidates every key already issued. See docs/DEPLOYMENT.md,
# "Domena, zanim cokolwiek innego".
APP_URL=https://kartoteka.example.pl

# Passphrase for the encrypted backups; see scripts/backup.sh.
# Keep a copy somewhere other than this server — a backup you cannot decrypt
# is not a backup.
BACKUP_PASSPHRASE=
