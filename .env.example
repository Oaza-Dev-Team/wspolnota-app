DATABASE_URL="postgresql://kartoteka:kartoteka_dev@localhost:5433/kartoteka?schema=public"

# The only source of a passkey's scope: both the relying-party id and the allowed
# origin for WebAuthn are derived from this one value (src/lib/auth/webauthn/config.ts),
# so it can never disagree with itself. In production, a missing APP_URL makes every
# sign-in and key registration fail immediately with a clear error rather than
# silently drifting from the real address. Changing it after keys exist invalidates
# all of them — see docs/DEPLOYMENT.md, "Domena, zanim cokolwiek innego".
APP_URL="http://localhost:3000"

# Development only. `npm run db:seed` empties every table before it writes,
# so it refuses without this. .dockerignore keeps .env out of every image,
# which is what stops the seed from ever running on a server.
SEED_ALLOW_WIPE="1"
