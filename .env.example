DATABASE_URL="postgresql://kartoteka:kartoteka_dev@localhost:5433/kartoteka?schema=public"
APP_URL="http://localhost:3000"

# Development only. `npm run db:seed` empties every table before it writes,
# so it refuses without this. .dockerignore keeps .env out of every image,
# which is what stops the seed from ever running on a server.
SEED_ALLOW_WIPE="1"
