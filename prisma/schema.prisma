generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RetreatKind {
  ONZ_I
  ONZ_II
  ONZ_III
  ORAR_I
  ORAR_II
  PILOTOWANIE
  ORD
  INNE
}

enum Role {
  admin
  region
  viewer
  // The technical account that keeps the installation running. Everything an
  // admin may do, plus the accounts an admin may not touch. Last because
  // ALTER TYPE ADD VALUE appends; the order carries no meaning.
  superadmin
}

enum AccountStatus {
  active
  disabled
  pending
}

enum AuditKind {
  edit
  create
  delete
  export
  account
}

model Region {
  id            Int    @id @db.SmallInt
  romanNumeral  String @map("roman_numeral")

  circles  Circle[]
  couples  Couple[]
  accounts Account[]

  @@map("region")
}

model Parish {
  id   BigInt @id @default(autoincrement())
  name String
  city String
  /// Generated column: lower-case, unaccented searchable text.
  /// Written by Postgres, never by the application.
  searchText String? @map("search_text")

  circles Circle[]
  couples Couple[]

  @@unique([name, city])
  @@map("parish")
}

model Circle {
  id       BigInt  @id @default(autoincrement())
  regionId Int     @map("region_id") @db.SmallInt
  number   Int     @db.SmallInt
  patron   String?
  parishId BigInt  @map("parish_id")
  /// Generated column; see Parish.searchText.
  searchText String? @map("search_text")

  region  Region   @relation(fields: [regionId], references: [id])
  parish  Parish   @relation(fields: [parishId], references: [id])
  couples Couple[]

  @@unique([regionId, number])
  @@map("circle")
}

model Couple {
  id          BigInt    @id @default(autoincrement())
  wifeName    String    @map("wife_name")
  husbandName String    @map("husband_name")
  surname     String
  email       String?
  phone       String?
  regionId    Int       @map("region_id") @db.SmallInt
  circleId    BigInt?   @map("circle_id")
  /// Only set when the couple belongs to a parish other than its circle's.
  /// Effective parish is COALESCE(couple.parish_id, circle.parish_id) — see spec 4.2.
  parishId    BigInt?   @map("parish_id")
  children    String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Generated column; see Parish.searchText.
  searchText  String?   @map("search_text")

  region   Region    @relation(fields: [regionId], references: [id])
  circle   Circle?   @relation(fields: [circleId], references: [id])
  parish   Parish?   @relation(fields: [parishId], references: [id])
  retreats Retreat[]

  @@index([regionId])
  @@index([surname])
  @@map("couple")
}

model Retreat {
  id       BigInt      @id @default(autoincrement())
  coupleId BigInt      @map("couple_id")
  kind     RetreatKind
  year     Int         @db.SmallInt
  place    String?
  name     String?

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([kind])
  @@map("retreat")
}

model Account {
  id               BigInt        @id @default(autoincrement())
  email            String        @unique
  passwordHash     String?       @map("password_hash")
  name             String
  role             Role
  regionId         Int?          @map("region_id") @db.SmallInt
  status           AccountStatus @default(pending)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(6)
  inviteTokenHash  String?       @map("invite_token_hash")
  inviteExpiresAt  DateTime?     @map("invite_expires_at") @db.Timestamptz(6)

  region   Region?   @relation(fields: [regionId], references: [id])
  sessions Session[]
  audit    Audit[]

  @@map("account")
}

model Session {
  id        BigInt @id @default(autoincrement())
  accountId BigInt @map("account_id")
  /// SHA-256 of the token. The raw token exists only in the user's cookie,
  /// so a database dump does not hand over live sessions.
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("session")
}

model Audit {
  id          BigInt    @id @default(autoincrement())
  at          DateTime  @default(now()) @db.Timestamptz(6)
  kind        AuditKind
  description String
  accountId   BigInt?   @map("account_id")
  /// Deliberately not a foreign key: the record may already be gone.
  coupleId    BigInt?   @map("couple_id")

  account Account? @relation(fields: [accountId], references: [id])

  @@index([at])
  @@map("audit")
}

model LoginAttempt {
  id   BigInt   @id @default(autoincrement())
  key  String
  at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([key, at])
  @@map("login_attempt")
}
